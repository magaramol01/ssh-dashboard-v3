# Maps use OpenStreetMap tiles; no API key is required.

# Server-only PostgreSQL connection. Never expose these through public runtime config.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=
PG_SSL=false

# Server-only Sentinel Copilot configuration.
NUXT_OPENROUTER_API_KEY=
NUXT_SENTINEL_MODEL=openai/gpt-4o-mini
